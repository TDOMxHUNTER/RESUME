import React, { useRef } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import { Float, Environment, Knot, Sphere, MeshTransmissionMaterial } from '@react-three/drei';

const FloatingShape = ({ position, rotation, scale, color }) => {
  const meshRef = useRef();

  useFrame((state) => {
    const t = state.clock.getElapsedTime();
    meshRef.current.rotation.x = Math.cos(t / 4) / 2;
    meshRef.current.rotation.y = Math.sin(t / 4) / 2;
    meshRef.current.position.y = position[1] + Math.sin(t / 1.5) / 10;
  });

  return (
    <group position={position} rotation={rotation} scale={scale}>
      <mesh ref={meshRef}>
        <torusKnotGeometry args={[1, 0.3, 128, 16]} />
        <MeshTransmissionMaterial 
           backside
           samples={4}
           thickness={0.5}
           roughness={0.15}
           clearcoat={1}
           clearcoatRoughness={0.1}
           transmission={1}
           background={color} 
           color={color}
           chromaticAberration={0.2}
           anisotropy={1}
        />
      </mesh>
    </group>
  );
};

const HeroScene = () => {
  return (
    <div style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', pointerEvents: 'none', zIndex: -1 }}>
      <Canvas camera={{ position: [0, 0, 15], fov: 45 }}>
        <Environment preset="studio" />
        
        <Float speed={2} rotationIntensity={0.5} floatIntensity={1}>
           <FloatingShape position={[5, 1, 0]} rotation={[0, 0, 0]} scale={2} color="#C5A059" />
        </Float>

        <Float speed={1.5} rotationIntensity={0.5} floatIntensity={0.5}>
           <FloatingShape position={[-6, -2, -2]} rotation={[0.5, 0.5, 0]} scale={1.5} color="#8A703E" />
        </Float>
      </Canvas>
    </div>
  );
};

export default HeroScene;
